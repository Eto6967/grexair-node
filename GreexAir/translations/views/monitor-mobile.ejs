    scales:{x:{grid:NOGRID,border:NB,ticks:{...TK,maxTicksLimit:4}},y:{grid:{display:false},border:NB,ticks:{color:'rgba(255,255,255,0.6)',font:{size:9,weight:'600'}}}}}
});

// updateUI
function updateUI(p){
  if(!p)return;
  // KPI
  var kpi=p.kpi||{};
  var cur=p.current_co2!=null?p.current_co2:kpi.current;
  if(cur!=null){
    var c=co2Col(cur);
    var el=document.getElementById('kpi-current');if(el){el.querySelector('b').textContent=Math.round(cur);el.querySelector('b').style.color=c.hex;}
    updateGauge(cur);
  }
  if(kpi.avg!=null){var a=document.getElementById('kpi-avg');if(a){a.querySelector('b').textContent=Math.round(kpi.avg);a.querySelector('b').style.color='#bf5af2';}}
  if(kpi.max!=null){var x=document.getElementById('kpi-max');if(x){x.querySelector('b').textContent=Math.round(kpi.max);x.querySelector('b').style.color='#ff453a';}}
  if(kpi.min!=null){var n=document.getElementById('kpi-min');if(n){n.querySelector('b').textContent=Math.round(kpi.min);n.querySelector('b').style.color='#30d158';}}

  // Status box
  if(p.air_status_key&&GX_TR[p.air_status_key]){
    var sb=document.getElementById('air-status-box');
    if(sb){
      var map={status_good:'status-good',status_warning:'status-warning',status_danger:'status-danger',status_nodata:'status-neutral'};
      sb.className='air-status-box '+(map[p.air_status_key]||'status-neutral');
      sb.textContent=GX_TR[p.air_status_key];
    }
  }

  // Frissítés ideje
  if(p.chartData&&p.chartData.length){
    var last=p.chartData[p.chartData.length-1];
    var lu=document.getElementById('last-update');if(lu&&last.x){var dt=new Date(last.x.replace(' ','T')+'Z');lu.textContent=isNaN(dt)?last.x.substring(11,16):dt.toLocaleTimeString(GX_LANG,{hour:'2-digit',minute:'2-digit'});}
  }

  // Chart adatok
  if(p.chartData&&p.chartData.length){
    var src=p.chartData;
    // Max 4000 pont mobilon
    if(src.length>4000){var step=Math.ceil(src.length/4000);var th=[];for(var i=0;i<src.length;i+=step)th.push(src[i]);src=th;}
    var ts=src.map(function(d){return isoToUnix(d.x);});
    var smooth=src.map(function(d){return d.y_smooth!=null?+d.y_smooth:(d.y_raw!=null?+d.y_raw:null);});
    var raw=src.map(function(d){return d.y_raw!=null?+d.y_raw:null;});
    var speeds=src.map(function(d){return d.speed!=null?+d.speed:null;});
    var accels=src.map(function(d){return d.accel!=null?+d.accel:null;});
    window._fullChartArrays={ts:ts,smooth:smooth,raw:raw,speeds:speeds,accels:accels};
    window._fullTimestamps=p.chartData.map(function(d){return d.x||'';});
    var activeBtn=document.querySelector('.ch-opt.active');
    window.applyZoom(activeBtn?activeBtn.dataset.zoom:'all');
  }

  // Time stats
  if(p.timeStats){window.timeBarChart.data.datasets[0].data=p.timeStats;window.timeBarChart.update('none');}

  // afterUpdate logika
  afterUpdate(p);
}

function afterUpdate(p){
  if(!p)return;
  var cur=parseInt(p.kpi&&p.kpi.current);
  // Trend
  if(p.chartData&&p.chartData.length>=2){
    var last=p.chartData[p.chartData.length-1],prev=p.chartData[Math.max(0,p.chartData.length-10)];
    var diff=Math.round((last.y_smooth||last.y_raw)-(prev.y_smooth||prev.y_raw));
    var tb=document.getElementById('kpi-trend');
    if(tb){tb.textContent=(diff>0?'+':'')+diff+' ppm';tb.className='kpi-trend '+(diff>20?'up':diff<-20?'down':'flat');}
    var st=document.getElementById('stat-trend'),sb2=document.getElementById('stat-trend-badge');
    if(st)st.textContent=(diff>0?'+':'')+diff;
    if(sb2){sb2.textContent=diff>20?(GX_TR.stat_rising||'Emelkedő'):diff<-20?(GX_TR.stat_falling||'Csökkenő'):(GX_TR.stat_stable||'Stabil');sb2.className='stat-row-badge '+(diff>20?'badge-up':diff<-20?'badge-down':'badge-flat');}
  }
  // Mérésszám
  var cnt2=p.chartData?p.chartData.length:0;
  var sc=document.getElementById('stat-count');if(sc)sc.textContent=cnt2.toLocaleString('hu-HU');
  var dc=document.getElementById('data-count');if(dc)dc.textContent=cnt2.toLocaleString('hu-HU');
  var cp=document.getElementById('count-pill');if(cp)cp.style.display=cnt2?'flex':'none';
  // Quality bars
  if(p.timeStats){var ts2=p.timeStats,tot=(ts2[0]||0)+(ts2[1]||0)+(ts2[2]||0)+(ts2[3]||0);setQL('good',ts2[0]||0,tot);setQL('ok',ts2[1]||0,tot);setQL('warn',ts2[2]||0,tot);setQL('crit',ts2[3]||0,tot);}
  // Peak time
  if(p.chartData&&p.kpi&&p.kpi.max&&window._fullTimestamps){
    for(var i=p.chartData.length-1;i>=0;i--){
      if(Math.round(p.chartData[i].y_raw)==p.kpi.max||Math.round(p.chartData[i].y_smooth)==p.kpi.max){
        var lbl=window._fullTimestamps[i];
        if(lbl){var dt2=new Date(lbl.replace(' ','T')+'Z');lbl=isNaN(dt2)?lbl.substring(11,16):dt2.toLocaleTimeString(GX_LANG,{hour:'2-digit',minute:'2-digit'});}
        var pt=document.getElementById('stat-peak-time'),pv=document.getElementById('stat-peak-val'),pb=document.getElementById('stat-peak-badge');
        if(pt&&lbl)pt.textContent=lbl;if(pv)pv.textContent=p.kpi.max+' ppm';
        if(pb){pb.className='stat-row-badge '+(p.kpi.max>1500?'badge-up':p.kpi.max>1000?'badge-warn':'badge-flat');pb.textContent=p.kpi.max>1500?(GX_TR.stat_critical||'Kritikus'):p.kpi.max>1000?(GX_TR.stat_warning||'Figyelem'):(GX_TR.stat_normal||'Normális');}
        break;
      }
    }
  }
  // Szellőzési mutató
  if(p.chartData&&p.chartData.length>=10){
    var cd=p.chartData,n=cd.length;
    var recent=cd.slice(n-5).map(function(d){return d.y_smooth||d.y_raw||0;});
    var older=cd.slice(n-10,n-5).map(function(d){return d.y_smooth||d.y_raw||0;});
    var avgR=recent.reduce(function(a,b){return a+b;},0)/recent.length;
    var avgO=older.reduce(function(a,b){return a+b;},0)/older.length;
    var d1=Math.round((avgR-avgO)*10)/10;
    var oldest=cd.slice(n-15,n-10).map(function(d){return d.y_smooth||d.y_raw||0;});
    var avgOldest=oldest.length?oldest.reduce(function(a,b){return a+b;},0)/oldest.length:avgO;
    var d2=Math.round((d1-(avgO-avgOldest))*10)/10;
    var vt,vs,vi,vc,vb;
    if(d1<-3&&d2<-0.5){vt=GX_TR.vent_accel_t;vs=GX_TR.vent_accel_s;vi='🌬️';vc='#30d158';vb=95;}
    else if(d1<-3){vt=GX_TR.vent_steady_t;vs=GX_TR.vent_steady_s;vi='💨';vc='#30d158';vb=82;}
    else if(d1<-1&&d2>0.5){vt=GX_TR.vent_slow_t;vs=GX_TR.vent_slow_s;vi='💨';vc='#5ac8fa';vb=68;}
    else if(d1<-1){vt=GX_TR.vent_mild_t;vs=GX_TR.vent_mild_s;vi='🍃';vc='#5ac8fa';vb=62;}
    else if(d1>=-1&&d1<=1){vt=GX_TR.vent_stable_t;vs=GX_TR.vent_stable_s;vi='✅';vc='#ffd60a';vb=50;}
    else if(d1>1&&d1<=3&&d2<-0.5){vt=GX_TR.vent_degrade_slow_t;vs=GX_TR.vent_degrade_slow_s;vi='⚠️';vc='#ff9f0a';vb=35;}
    else if(d1>1&&d1<=3){vt=GX_TR.vent_degrade_mild_t;vs=GX_TR.vent_degrade_mild_s;vi='⚠️';vc='#ff9f0a';vb=30;}
    else if(d1>3&&d2>0.5){vt=GX_TR.vent_degrade_fast_t;vs=GX_TR.vent_degrade_fast_s;vi='🚨';vc='#ff453a';vb=5;}
    else{vt=GX_TR.vent_rapid_t;vs=GX_TR.vent_rapid_s;vi='🚨';vc='#ff453a';vb=12;}
    var vtEl=document.getElementById('vent-status-text');if(vtEl){vtEl.textContent=vt;vtEl.style.color=vc;}
    var vsEl=document.getElementById('vent-status-sub');if(vsEl)vsEl.textContent=vs;
    var viEl=document.getElementById('vent-icon');if(viEl)viEl.textContent=vi;
    var vd1El=document.getElementById('vent-d1');if(vd1El){vd1El.textContent=(d1>0?'+':'')+d1+' ppm/p';vd1El.style.color=d1>1?'#ff453a':d1<-1?'#30d158':'#ffd60a';}
    var vbarEl=document.getElementById('vent-bar');if(vbarEl){vbarEl.style.width=vb+'%';vbarEl.style.background=vc;}
    // Szellőztetési napló
    _ventLog=[];
    var WIN=15,inVent=false,ventStartIdx=0;
    function gv(d){return parseFloat(d.y_smooth||d.y_raw||0);}
    for(var vi2=WIN;vi2<cd.length;vi2++){
      var vNow=gv(cd[vi2]),vBack=gv(cd[vi2-WIN]),vSlope=vNow-vBack;
      if(!inVent&&vSlope<-15){inVent=true;ventStartIdx=vi2-WIN;}
      else if(inVent&&vSlope>=0){
        inVent=false;
        var vDrop=Math.round(gv(cd[ventStartIdx])-vNow);
        if(vDrop>20)_ventLog.push({start:(cd[ventStartIdx].x||'').substring(11,16),end:(cd[vi2].x||'').substring(11,16),from:Math.round(gv(cd[ventStartIdx])),to:Math.round(vNow),drop:vDrop});
      }
    }
    _ventLog.reverse();if(_ventLog.length>8)_ventLog=_ventLog.slice(0,8);
    renderVentLog();
  }
  addAlert(cur);
}

// Socket
var socket=io();
socket.on('update_data',function(p){if(isLiveMode)updateUI(p);});
socket.on('connect',function(){
  var btn=document.getElementById('live-btn');
  if(btn&&isLiveMode)btn.className='active';
  if(!isLiveMode)loadDate(document.getElementById('date-selector').value);
});
socket.on('disconnect',function(){var btn=document.getElementById('live-btn');if(btn)btn.className='offline-mode';});

// Load history
function loadDate(date){
  fetch('/api/history',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({date:date})})
    .then(function(r){return r.json();}).then(function(d){if(!d.error)updateUI(d);}).catch(function(e){console.error(e);});
}
document.getElementById('date-selector').addEventListener('change',function(){loadDate(this.value);});

// PDF
document.getElementById('pdf-btn').addEventListener('click',function(){
  window.open('/report?date='+document.getElementById('date-selector').value,'_blank','width=900,height=700');
});

// Preloader
window.addEventListener('load',function(){
  requestAnimationFrame(function(){
    initUPlots();
    setTimeout(function(){
      var pl=document.getElementById('preloader');if(pl)pl.classList.add('gone');
      if(!isLiveMode)loadDate(document.getElementById('date-selector').value);
    },300);
  });
});
