            <path d="M1 6h14" stroke="#0a84ff" stroke-width="1.4"/>
            <path d="M5 1v2M11 1v2" stroke="#0a84ff" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="gx-modal-title">Nap kiválasztása</div>
          <div class="gx-modal-sub"><%= available_dates.length %> elérhető nap</div>
        </div>
      </div>
      <button class="gx-modal-close" onclick="closeDateModal()">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Body -->
    <div class="gdm-body" id="gdm-scroll">
      <% groupOrder2.forEach(function(ym){ %>
        <%
          var parts2 = ym.split('-');
          var mLabel2 = MONTH_NAMES2[parseInt(parts2[1],10)-1] + ' ' + parts2[0];
        %>
        <div class="gdm-month-label"><%= mLabel2 %></div>
        <div class="gdp-month-grid gdm-grid">
          <% groups2[ym].forEach(function(date){
            var day2 = parseInt(date.slice(8,10),10);
            var isActive2 = date === default_date;
            var isToday2  = date === today2;
          %>
          <div class="gdp-day <%= isActive2?'active':'' %> <%= isToday2?'today':'' %>"
               data-val="<%= date %>"
               title="<%= date %>"
               onclick="selectDate('<%= date %>')">
            <span class="gdp-day-num"><%= day2 %></span>
            <% if(isToday2){ %><span class="gdp-today-dot"></span><% } %>
          </div>
          <% }); %>
        </div>
      <% }); %>
    </div>

    <!-- Footer -->
    <div class="gdm-footer">
      <div class="gdm-selected-label">Kiválasztva:</div>
      <div class="gdm-selected-val" id="gdm-selected-val"><%= default_date %></div>
    </div>
  </div>
</div>

