<!-- ── DATE PICKER MODAL ── -->
<%
  var today2 = new Date().toISOString().slice(0,10);
  var MONTH_NAMES2 = ['Január','Február','Március','Április','Május','Június','Július','Augusztus','Szeptember','Október','November','December'];
  var groups2 = {}, groupOrder2 = [];
  available_dates.forEach(function(d){
    var ym = d.slice(0,7);
    if (!groups2[ym]) { groups2[ym] = []; groupOrder2.push(ym); }
    groups2[ym].push(d);
  });
%>
<div id="gx-date-modal" class="gx-modal-overlay">
  <div class="gx-modal-panel gdm-panel">
    <!-- Header -->
    <div class="gx-modal-header">
      <div class="gx-modal-title-wrap">
