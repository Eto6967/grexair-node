<%
var tr = (typeof tr !== 'undefined' && tr) ? tr : {};
var lang = (typeof lang !== 'undefined' && lang) ? lang : 'hu';
%>
<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="dark">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>GrexAir · <%= tr.nav_upload %></title>
  <link rel="icon" type="image/png" href="/static/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/grexair.css">
  <script src="/static/js/theme.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<div id="preloader"><div class="pl-wrap"><img src="/static/logo.png" class="pl-logo" alt="" onerror="this.style.display='none'"><div class="pl-bar"><div class="pl-bar-fill"></div></div></div></div>
<div class="aurora"><div class="ao ao1"></div><div class="ao ao2"></div><div class="ao ao3"></div><div class="ao ao4"></div></div>
<div class="grain"></div>
<nav class="gx-nav">
  <a href="/" class="nav-brand"><div class="nav-logo-wrap"><img src="/static/logo.png" alt="GrexAir" onerror="this.outerHTML='<span style=&quot;color:#fff;font-size:10px;font-weight:800&quot;>CO₂</span>'"></div><div><div class="nav-brand-name">GrexAir</div><div class="nav-brand-tagline">CO₂ Monitor</div></div></a>
  <div class="nav-links">
    <a href="/" class="nav-link"><i class="fas fa-chart-line" style="font-size:10px;margin-right:4px"></i><%= tr.nav_monitor %></a>
    <a href="/upload" class="nav-link active"><i class="fas fa-upload" style="font-size:10px;margin-right:4px"></i><%= tr.nav_upload %></a>
  </div>
  <div class="nav-right">
    <div class="lang-picker" id="lang-picker">
      <button class="lang-current" onclick="toggleLangMenu()" id="lang-btn">
        <span class="fi fi-<%= lang==='en'?'gb':lang==='uk'?'ua':lang==='sr'?'rs':lang==='sl'?'si':lang==='sk'?'sk':lang==='hr'?'hr':lang==='ro'?'ro':lang==='de'?'de':lang==='ru'?'ru':'hu' %>" style="width:18px;height:14px;border-radius:2px;flex-shrink:0"></span>
        <span class="lang-code"><%= lang.toUpperCase() %></span>
        <i class="fas fa-chevron-down" style="font-size:8px;opacity:.5"></i>
      </button>
      <div class="lang-menu" id="lang-menu" style="display:none">
        <% [['hu','hu','Magyar'],['en','gb','English'],['de','de','Deutsch'],['sk','sk','Slovenčina'],['ro','ro','Română'],['hr','hr','Hrvatski'],['sr','rs','Srpski'],['sl','si','Slovenščina'],['uk','ua','Українська'],['ru','ru','Русский']].forEach(function(l){ %>
        <a href="/set-lang/<%= l[0] %>" class="lang-option <%= lang===l[0]?'active':'' %>">
          <span class="fi fi-<%= l[1] %>" style="width:18px;height:14px;border-radius:2px;flex-shrink:0"></span>
          <span><%= l[2] %></span>
        </a>
        <% }); %>
      </div>
    </div>
    <button class="theme-btn" id="theme-toggle"><i class="fas fa-sun" id="theme-icon"></i></button>
  </div>
</nav>
<div class="gx-page"><div class="gx-upload-page">
  <div class="gx-hero gx-a0"><div><h1><%= tr.upload_page_title %></h1><div class="gx-hero-sub"><i class="fas fa-upload" style="font-size:9px"></i><%= tr.upload_page_sub %></div></div></div>
  <a href="/" class="back-link gx-a0"><i class="fas fa-arrow-left" style="font-size:10px"></i><%= tr.btn_back %></a>
  <div class="gx-card gx-a1" style="padding:22px 24px;margin-bottom:20px">
    <div style="font-size:12px;font-weight:700;color:var(--t1);margin-bottom:14px;display:flex;align-items:center;gap:8px">
      <i class="fas fa-file-csv" style="color:var(--blue);font-size:13px"></i> <%= tr.upload_csv_title %>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <!-- Bal oldal: szabályok -->
      <div>
        <div style="font-size:10px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--t3);margin-bottom:10px"><%= tr.upload_cols_required %></div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="display:flex;align-items:flex-start;gap:10px;padding:8px 12px;background:rgba(10,132,255,0.07);border:1px solid rgba(10,132,255,0.2);border-radius:8px">
            <i class="fas fa-clock" style="color:var(--blue);font-size:11px;margin-top:1px;flex-shrink:0"></i>
            <div>
              <div style="font-size:11px;font-weight:600;color:var(--t1)"><%= tr.upload_col_ts %></div>
              <div style="font-size:10px;color:var(--t3);margin-top:2px"><%- tr.upload_col_ts_hint %></div>
              <div style="font-size:10px;color:var(--t3);margin-top:3px"><%= tr.upload_col_ts_fmt %></div>
            </div>
          </div>
          <div style="display:flex;align-items:flex-start;gap:10px;padding:8px 12px;background:rgba(48,209,88,0.07);border:1px solid rgba(48,209,88,0.2);border-radius:8px">
            <i class="fas fa-wind" style="color:var(--green);font-size:11px;margin-top:1px;flex-shrink:0"></i>
            <div>
              <div style="font-size:11px;font-weight:600;color:var(--t1)"><%= tr.upload_col_co2 %></div>
              <div style="font-size:10px;color:var(--t3);margin-top:2px"><%- tr.upload_col_co2_hint %></div>
              <div style="font-size:10px;color:var(--t3);margin-top:3px"><%- tr.upload_col_co2_val %></div>
            </div>
          </div>
        </div>
        <div style="margin-top:12px;font-size:10px;color:var(--t3);display:flex;gap:12px">
          <span><i class="fas fa-check" style="color:var(--green);margin-right:4px"></i><%- tr.upload_sep %></span>
          <span><i class="fas fa-check" style="color:var(--green);margin-right:4px"></i><%- tr.upload_enc %></span>
        </div>
      </div>
      <!-- Jobb oldal: példák -->
      <div>
        <div style="font-size:10px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:var(--t3);margin-bottom:10px"><%= tr.upload_examples %></div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="background:rgba(0,0,0,0.35);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px">
            <div style="font-size:9px;font-weight:700;letter-spacing:.6px;color:var(--t3);margin-bottom:6px"><%= tr.upload_arduino_native %></div>
            <pre style="margin:0;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--t2);line-height:1.6">Timestamp,CO2_ppm
2026-03-22 08:00:00,1145
2026-03-22 08:00:03,1148
2026-03-22 08:00:06,1151</pre>
          </div>
          <div style="background:rgba(0,0,0,0.35);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px">
            <div style="font-size:9px;font-weight:700;letter-spacing:.6px;color:var(--t3);margin-bottom:6px"><%= tr.upload_daily_archive %></div>
            <pre style="margin:0;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--t2);line-height:1.6">Ido;CO2_ppm
08:00:00;1145
08:01:00;1148
08:02:00;1151</pre>
          </div>
        </div>
      </div>
    </div>
    <!-- Arduino kód tipp -->
    <div style="margin-top:14px;padding:10px 14px;background:rgba(255,159,10,0.07);border:1px solid rgba(255,159,10,0.2);border-radius:8px;display:flex;align-items:flex-start;gap:10px">
      <i class="fas fa-microchip" style="color:var(--org);font-size:11px;margin-top:2px;flex-shrink:0"></i>
      <div style="font-size:10.5px;color:var(--t2);line-height:1.6">
        <strong style="color:var(--org)"><%= tr.upload_arduino_tip_label %></strong> <%= tr.upload_arduino_tip_body %> 
        <code style="color:var(--t1);background:rgba(255,255,255,0.07);padding:2px 6px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:10px">file.print(timestamp); file.print(","); file.println(co2_ppm);</code>
        <%= tr.upload_arduino_tip_first %> <code style="color:var(--t1);background:rgba(255,255,255,0.07);padding:2px 6px;border-radius:4px;font-family:'JetBrains Mono',monospace;font-size:10px">Timestamp,CO2_ppm</code>
      </div>
    </div>
  </div>
  <% if (error) { %><div class="error-box gx-a1"><i class="fas fa-exclamation-triangle"></i><%= error %></div><% } %>
  <div class="gx-card gx-a2" style="padding:26px;margin-bottom:22px">
    <form action="/upload" method="POST" enctype="multipart/form-data">
      <div class="drop-zone" id="drop-zone"><div class="drop-icon">📄</div><div class="drop-title"><%= tr.upload_drop_title %></div><div class="drop-sub"><%= tr.upload_drop_sub %></div><input type="file" name="file" accept=".csv" required id="file-input"><div class="file-chosen" id="file-chosen"></div></div>
      <button type="submit" class="upload-btn"><i class="fas fa-chart-line" style="margin-right:8px"></i><%= tr.upload_btn_analyze %></button>
    </form>
  </div>
  <% if (payload) { %>
  <div class="sec-label gx-a3"><%= tr.upload_result_title %></div>
  <div class="gx-kpi-grid gx-a3">
    <div class="gx-card kpi-card hoverable" style="border-top:2px solid var(--blue)"><div class="kpi-card-top"><span class="kpi-label"><%= tr.kpi_last %></span></div><div class="kpi-val" style="color:var(--blue)"><%= payload.kpi.current %><span class="kpi-unit"> ppm</span></div></div>
    <div class="gx-card kpi-card hoverable" style="border-top:2px solid var(--pur)"><div class="kpi-card-top"><span class="kpi-label"><%= tr.kpi_avg %></span></div><div class="kpi-val" style="color:var(--pur)"><%= payload.kpi.avg %><span class="kpi-unit"> ppm</span></div></div>
    <div class="gx-card kpi-card hoverable" style="border-top:2px solid var(--red)"><div class="kpi-card-top"><span class="kpi-label"><%= tr.kpi_max %></span></div><div class="kpi-val" style="color:var(--red)"><%= payload.kpi.max %><span class="kpi-unit"> ppm</span></div></div>
    <div class="gx-card kpi-card hoverable" style="border-top:2px solid var(--green)"><div class="kpi-card-top"><span class="kpi-label"><%= tr.kpi_min %></span></div><div class="kpi-val" style="color:var(--green)"><%= payload.kpi.min %><span class="kpi-unit"> ppm</span></div></div>
    <div class="gx-card kpi-card hoverable" style="border-top:2px solid var(--teal)"><div class="kpi-card-top"><span class="kpi-label"><%= tr.kpi_range %></span></div><div class="kpi-val" style="color:var(--teal)"><%= payload.kpi.max-payload.kpi.min %><span class="kpi-unit"> ppm</span></div></div>
  </div>
  <div class="gx-card chart-wrap gx-a4" style="margin-bottom:12px">
    <div class="chart-header"><div class="chart-title-block"><div class="chart-title-main"><%= tr.chart_co2_title %></div><div class="chart-title-sub"><%= tr.chart_co2_sub %></div></div></div>
    <div class="chart-h-xl"><canvas id="co2Chart"></canvas></div>
  </div>
  <div class="gx-row cols-3 gx-a5">
    <div class="gx-card chart-wrap"><div class="chart-header"><div class="chart-title-block"><div class="chart-title-main" style="--blue:#bf5af2"><%= tr.chart_speed_title %></div></div></div><div class="chart-h-md"><canvas id="speedChart"></canvas></div></div>
    <div class="gx-card chart-wrap"><div class="chart-header"><div class="chart-title-block"><div class="chart-title-main" style="--blue:#ff9f0a"><%= tr.chart_accel_title %></div></div></div><div class="chart-h-md"><canvas id="accelChart"></canvas></div></div>
    <div class="gx-card chart-wrap"><div class="chart-header"><div class="chart-title-block"><div class="chart-title-main" style="--blue:#30d158"><%= tr.chart_dist_label %></div></div></div><div class="chart-h-md"><canvas id="timeBarChart"></canvas></div></div>
  </div>
  <script>const DEMO_PAYLOAD=<%- JSON.stringify(payload) %>;</script>
  <script src="/static/js/main.js"></script>
  <% } %>
</div></div>
<script>
document.getElementById('file-input').onchange=function(){document.getElementById('file-chosen').textContent=this.files[0]?'📎 '+this.files[0].name:''};
var dz=document.getElementById('drop-zone');
dz.addEventListener('dragover',function(e){e.preventDefault();dz.classList.add('drag-over')});
dz.addEventListener('dragleave',function(){dz.classList.remove('drag-over')});
dz.addEventListener('drop',function(e){e.preventDefault();dz.classList.remove('drag-over');var f=e.dataTransfer.files;if(f.length){document.getElementById('file-input').files=f;document.getElementById('file-chosen').textContent='📎 '+f[0].name;}});
function toggleLangMenu(){var m=document.getElementById('lang-menu');if(m)m.style.display=m.style.display==='none'?'block':'none';}
document.addEventListener('click',function(e){var p=document.getElementById('lang-picker');if(p&&!p.contains(e.target)){var m=document.getElementById('lang-menu');if(m)m.style.display='none';}});
</script>
</body>
</html>
